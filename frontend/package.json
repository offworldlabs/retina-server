{
  "name": "retina",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "npm run typecheck:src && npm run typecheck:e2e",
    "typecheck:src": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:local": "E2E_ENV=local playwright test",
    "test:e2e:staging": "E2E_ENV=staging playwright test",
    "test:e2e:prod": "E2E_ENV=prod playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  }
}
