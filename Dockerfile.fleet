# syntax=docker/dockerfile:1
# Fleet simulator container

ARG UV_VERSION=0.12.5
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:3.12-slim
WORKDIR /app

# Synced from backend/uv.lock as the server image is; the Dockerfile explains the
# venv and the flags. One layer, since nothing here is rebuilt often enough for
# the server image's two-step split to pay.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    PATH=/opt/venv/bin:$PATH
COPY backend/pyproject.toml backend/uv.lock backend/.python-version ./backend/
COPY libs/ ./libs/
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    cd backend && uv sync --locked --no-dev --no-editable --no-cache --compile-bytecode

# Copy backend code (fleet orchestrator + simulation world + fleet generator)
COPY backend/ ./backend/

# Data directory for ground truth output
RUN mkdir -p /app/data

# Entry script reads env vars and launches fleet orchestrator
COPY deploy/fleet-entrypoint.sh /app/fleet-entrypoint.sh
RUN chmod +x /app/fleet-entrypoint.sh

CMD ["/app/fleet-entrypoint.sh"]
