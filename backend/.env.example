# Environment and the two flags that used to be implied by it. Documented here
# for reference, but deliberately left commented out rather than set.
#
# Read this before trusting anything in this file. main.py calls load_dotenv()
# only after the route imports, and the backend reads its configuration in 22
# module-level os.getenv calls that all run during those imports. So on a bare
# `uvicorn main:app` most of this file arrives too late to have any effect. Pass
# what you need on the command line, or use `just up`, which does it for you. On
# a droplet none of this bites, because compose injects the file via `env_file:`
# before the process starts.
#
# The three below are commented out for a second reason. Compose injects this
# whole file, so a live value here would outlive the day someone deletes the
# matching line from the overlay, and for the anonymous-admin bypass that
# failure is both silent and open.
#
# To change a deployed box, edit docker-compose.{prod,staging,test}.yml.
#
# RETINA_ENV gates the JWT_SECRET boot check, the RADAR_API_KEY fail-fast and
# the missing-key log levels in radar.py and tcp_handler.py. Deployed:
# `production` on prod, `test` on staging and test.
# RETINA_ENV=dev
#
# AUTH_ALLOW_ANONYMOUS_ADMIN grants every caller anonymous admin when Cloudflare
# Access is not configured. Off unless set to exactly `1`. Deployed nowhere:
# only docker-compose.local.yml sets it, because a laptop has no Access
# assertion. Administrators reach a droplet through Cloudflare Access
# instead, verified at the origin against CF_ACCESS_AUD. While it is set, the
# admin surfaces that serve TRUE node locations — the ones NODE_FUZZ_MODE below
# exists to keep off the public map — are open to any anonymous caller, and the
# server logs a warning at every boot saying so.
# AUTH_ALLOW_ANONYMOUS_ADMIN=1
#
# SYNTHETIC_FLEET_ENABLED turns on the simulation subsystem: for now the ingest
# write path the fleet POSTs through, and in time the fleet container itself.
# It is the sole gate on that mount, so any environment wanting the subsystem
# has to set it, whatever it is named. Deployed: `1` on the test droplet alone,
# the one environment that still runs a fleet; staging and production leave it
# unset.
# SYNTHETIC_FLEET_ENABLED=1
#
# On by default, holding ungraduated polled radars off the solve, archive and
# public map; exactly `0` switches it off and they flow like fleet nodes.
# POLLED_RADAR_PROBATION_ENABLED=0
#
# Polls registered stock-blah2 radars into the pipeline; exactly `1` turns it
# on. A radar must be polled by one server only, so production alone sets it,
# in docker-compose.prod.yml.
# POLLED_RADAR_POLLING_ENABLED=1
#
# Polls adsb-service (ADSBHub traffic at adsb.retina.fm) over the regions the
# real nodes occupy, every 5 s, for claiming to bind against where a node sends
# no ADS-B of its own; exactly `1` turns it on. The service allows 2 requests a
# second per address, and a synthetic fleet polls it too, so where
# SYNTHETIC_FLEET_ENABLED=1 the two share that budget.
# ADSB_FALLBACK_ENABLED=1

# Auth: the key that signs session cookies and the reset/verify tokens. Left
# empty deliberately. A local run falls back to a built-in dev secret, and a
# deployed box must generate its own:
#
#     printf 'JWT_SECRET=%s\n' "$(openssl rand -hex 32)" >> backend/.env
#
# It used to read `change-me-in-production`, which was harmless while no
# environment was named `production`. Now that one is, core/users.py requires
# the key, and a placeholder published in this repo would have satisfied that
# check with a secret anyone can read. deploy/setup-server.sh generates one for
# a new box, and the production deploy refuses to run without at least 32
# characters here.
JWT_SECRET=

# Fernet key for polled radars' stored passwords; unset refuses to store one. Generate with
#     python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
POLLED_RADAR_SECRET_KEY=

# Mail: the Cloudflare API token that authorises a send through the Email
# Sending REST API. It needs one permission, `Email Sending: Edit`, and the
# sender domain must be onboarded for Email Sending on CLOUDFLARE_ACCOUNT_ID.
#
# Empty here and set per box. Without it MAIL_TRANSPORT=cloudflare resolves to
# unconfigured and mail is dropped with a warning rather than the process
# refusing to start: the same process carries the radar pipeline.
#
# MAIL_TRANSPORT, MAIL_FROM and CLOUDFLARE_ACCOUNT_ID are not here — they are
# the same everywhere and live in docker-compose.yml, where
# check-env-parity.py can see them drift.
CLOUDFLARE_EMAIL_TOKEN=

# Alerting: webhook for health/critical alerts. Body shape set by ALERT_WEBHOOK_FORMAT below
# (a Slack/Discord/PagerDuty incoming webhook, or a ClickUp chat channel).
# This and ALERT_WEBHOOK_AUTH carry a destination and a credential, so they stay
# out of the compose overlays and live only here; deploy/start.sh refuses to boot
# production without them. docs/runbook.md says how to restore them.
ALERT_WEBHOOK_URL=
# Re-notify cooldown per alert type, seconds (default 300). The deployed stacks
# set this in their compose overlay, which wins over this file.
ALERT_COOLDOWN_S=300
# Sent verbatim as the Authorization header (e.g. a ClickUp personal token, no "Bearer " prefix)
ALERT_WEBHOOK_AUTH=
# Payload shape for ALERT_WEBHOOK_URL: raw (default) or clickup_chat. Set by the
# compose overlay on a deployed stack, same as ALERT_ENVIRONMENT below.
ALERT_WEBHOOK_FORMAT=
# Labels each alert's "environment" field (production/staging/test). The deployed
# stacks set this in their compose overlay; a bare local run is not expected to.
ALERT_ENVIRONMENT=
# Dormant: pings this URL on HEARTBEAT_INTERVAL_S when set, and no environment sets it.
# Outside-in probing is DigitalOcean Uptime's job
# (claude-shared/docs/runbooks/uptime-monitoring.md).
HEARTBEAT_URL=

# Health-check thresholds. All fall back to their default on a value that
# does not parse, rather than stopping the server booting.
# Fleet-average miss rate above which the network counts as blind (default
# 0.98). Set clear of the 72-94% band the network reports when it is working:
# see services/health.py for why an absolute threshold is a stopgap here.
HIGH_MISS_RATE_THRESHOLD=
# Fraction of peak connected nodes below which node_dropout fires (default 0.8).
NODE_DROPOUT_THRESHOLD=
# How recently (seconds) the solver queue must have refused a candidate for
# solver_queue_drops to fire (default 300). The lifetime count stays in the
# admin metrics; health only cares whether the solver is behind right now.
SOLVER_QUEUE_DROP_WINDOW_S=
# Longest (seconds) an overlap-grid rebuild may wait behind the per-cycle
# budget before coverage_rebuild_backlog fires (default 1200). Must clear the
# cold start, which queues every node at once: ceil(nodes / 3) cycles of 30 s,
# so raise this above that for a fleet larger than ~120 nodes.
COVERAGE_BACKLOG_MAX_WAIT_S=
# Window (s) in which a node that is heard from must file a frame a minute,
# capped at 15, or frame_starvation:<node_id> fires (default 900).
FRAME_STARVATION_S=

# Mender, read by the in-request device lookup that registration will gate on.
# Same names as node-infra/mender-auto-accept, because it is the same credential
# against the same tenant: one name per secret, so a rotation cannot be applied
# to one component and missed on the other.
#
# MENDER_PAT is a Mender Personal Access Token. Hosted Mender issues no service
# accounts and no per-token scope, so this token inherits everything its creator
# can do, including decommissioning devices and deploying artefacts to the whole
# fleet. retina-server only ever reads devauth with it. See ADR A10 and D26.
#
# This is a bring-up credential, accepted on the terms above so twelve nodes can
# stream by 2026-08-16. The exit is ADR Q1: have mender-auto-accept push the
# accepted-device list here instead, which leaves this file holding no Mender
# credential at all. Keep the file mode at 0600.
MENDER_PAT=
# MENDER_SERVER=https://hosted.mender.io
# MENDER_TIMEOUT_S=3.0

# Node id prefixes that may be force-retired through
# DELETE /api/admin/nodes/{id}/state?force=true. Empty means unrestricted,
# which is what a deployment carrying real receivers wants: a decommissioned
# board also needs force, since nothing else evicts it from the fleet registry.
# Staging sets the E2E prefixes, which also marks those ids disposable: the
# server retires them itself once they have been quiet for 15 minutes, and
# unset it retires nothing. Never list a prefix a returning node uses. Read per
# retirement rather than at import, so unlike most keys in this file it does
# take effect when set here. See ClickUp 86cb5nxvw.
# NODE_FORCE_RETIRE_PREFIXES=

# Multinode solver. SOLVER_WORKERS is both the number of queue-draining threads
# and the size of the process pool they ship the LM solves to; the deployed
# value must fit the container's cpus limit alongside the main process.
#
# SOLVER_RESOLVE_INTERVAL_S is how long an aircraft is not re-solved for.
# Association is rate-limited per node, so every node that sees an aircraft
# emits its own candidate for it and most arrivals are duplicates; this is the
# window that suppresses them. Do not exceed the multinode_tracks expiry
# (MN_DARK_EXPIRY_S below for dark tracks, 60 s for ADS-B-assisted ones) —
# tracks would lapse between solves. 0 turns the suppression off. See
# services/tasks/solver.py and docs/runbook.md's solver_latency_high entry.
#
# SOLVER_MAX_DISPLACEMENT_KM_DARK is how far a DARK (no-ADS-B) solve may land
# from its association guess before it is rejected; the default is 6 km = 2 x
# the 3 km association grid step, since a dark guess is a quantised grid point
# rather than an ADS-B fix. ADS-B-anchored solves keep the fixed 2 km cap.
#
# MN_DR_CAP_S is how far a multinode entry is dead-reckoned past its last
# solve before it holds position, and MN_DARK_EXPIRY_S is when a DARK
# (mn-dark-*) entry is dropped from the feed entirely. Both are position-error
# budgets: measured against ground truth, dark entries run 1.5 km median error
# at 8-15 s of solve age but 2.0 km at 15-30 s and 4.0 km at 30-60 s. ADS-B-
# assisted (mn-adsb-*) entries keep the 60 s expiry — a transponder hex anchors
# them. Raise both to trade position accuracy for track continuity.
#
# SOLVER_ALT_MODE is how an n>=3 solve gets its altitude. sweep (default)
# solves once per fixed altitude layer and keeps the lowest rms_delay — six
# process-pool round trips per candidate, and an altitude quantised to a
# ladder whose 2 km spacing puts up to 1 km of error straight into the
# residual the reject gate reads. free makes one pool call to the geolocator's
# multi-start helper, which solves altitude as a sixth unknown. Both modes
# stamp altitude_mode on the solve-history record, so /api/test/mlat-history
# can compare them across a deploy of each. See docs/solverflow.md.
#
# SOLVER_FREE_ALT_STARTS is how many start altitudes free mode gives that
# helper, clamped to the number of layers. 1 (the default) starts at the layer
# nearest the association guess, or at the guess altitude itself when it comes
# from ADS-B; more is a window around it, at one LM run each. Measured on test
# over 1019 free solves, three starts changed rms_delay by more than 0.1 us in
# 13 of them, so the extra runs are off by default and worth turning on only
# where the geometry sends a single start to the wrong side of an ellipse.
# SOLVER_WORKERS=2
# SOLVER_RESOLVE_INTERVAL_S=12
# SOLVER_MAX_DISPLACEMENT_KM_DARK=6.0
# MN_DR_CAP_S=15.0
# MN_DARK_EXPIRY_S=30.0
# SOLVER_ALT_MODE=sweep
# SOLVER_FREE_ALT_STARTS=1

# Mint-time retirement of coasting dark keys (solver.py's
# _stale_coast_candidate, docs/solverflow.md section 6). When a dark aircraft
# turns hard, the KF's manoeuvre boost pushes its velocity sigma past
# DARK_FOLLOW_MAX_VEL_SIGMA_MS, the follow lane drops the key, and the fix lane
# mints a SECOND key for the same aircraft. Supersession cannot retire the
# first — its shared-source-track-id prefilter is empty through a turn (node
# tracks renumber) and its distance test measures the dead reckoning the turn
# invalidated — so the old key keeps being drawn, coasting on the frozen
# pre-turn velocity and often renewed by later solves. Measured over four
# 20-minute ground-truth captures: 9 of 13 re-keyed turns left such a ghost,
# median 52 s visible and 11.3 km from the aircraft whose identity it carried.
#
# A minted dark key therefore looks for the key it replaced and retires it,
# transplanting the trail so the new hex does not start from the turn. The
# gates are narrow because a wrong retirement deletes a live aircraft's key:
# the candidate's last solve must be MN_STALE_COAST_MIN_S..MAX_S old (below the
# floor it is being tracked, not coasted), its RAW position within
# min(MN_STALE_COAST_MAX_KM, MN_STALE_COAST_VMAX_MS*dt + 2 km) and 1000 m of
# this RAW solve, and there must be evidence of the turn itself — either
# dark_follow dropped that key inside its cooldown, or the KF still reports a
# manoeuvre level above MN_STALE_COAST_MANOEUVRE. Proximity alone is never
# enough; that is what popped neighbours' keys before the 2026-09-05 guard.
#
# MN_STALE_COAST_ENABLED=0 disables the whole block. Watch
# mn_stale_coast_retired against mn_stale_coast_blocked_evidence on
# /api/test/solver-stats: the second is every retirement proximity alone would
# have made and this rule refuses.
# MN_STALE_COAST_ENABLED=1
# MN_STALE_COAST_MIN_S=4.0
# MN_STALE_COAST_MAX_S=60.0
# MN_STALE_COAST_MAX_KM=10.0
# MN_STALE_COAST_VMAX_MS=350.0
# MN_STALE_COAST_MANOEUVRE=0.3

# Dark track following (services/dark_follow.py, docs/solverflow.md 3d). The
# known lane's top-down claim applied to aircraft with no transponder: an
# established mn-dark-* track's Kalman state predicts delay/Doppler at each
# node, matching detections are claimed against it, and the resulting solve
# carries the followed key as its anchor so it lands back on the SAME track.
#
# DARK_FOLLOW_MODE: off | shadow | binding. shadow (the default) claims,
# solves and records but leaves the detections in the dark pool and publishes
# nothing; binding strips them and publishes through the normal dark gates.
#
# The rest are the eligibility and guard thresholds. A key is followable while
# its last solve is under MAX_AGE_S old with at least MIN_SOLVES solves and a
# filter velocity sigma under MAX_VEL_SIGMA_MS; it is dropped for COOLDOWN_S
# after two consecutive rejected follow-solves, which is what stops a ghost
# locking itself onto the map. INTERVAL_S rate-limits follow-solves per key.
#
# The MANOEUVRE_* keys are the one exception to the sigma ceiling. A turning
# aircraft's velocity sigma is inflated by the display filter's manoeuvre
# detector on purpose (services/track_filter.py), so the ceiling used to fire
# hardest on the aircraft the lane most needs to follow. A key whose manoeuvre
# level is at least MANOEUVRE_KEEP is kept for up to MANOEUVRE_KEEP_MAX_S per
# turn instead of dropped, provided its sigma is still under
# MANOEUVRE_MAX_VEL_SIGMA_MS. The claim gates do NOT widen with it:
# GATE_VEL_SIGMA_CAP_MS clamps the sigma the gates are derived from, so a kept
# key claims at the same width as a normal one. Set MANOEUVRE_KEEP above 1.0
# to disable the reprieve.
# DARK_FOLLOW_MODE=shadow
# DARK_FOLLOW_MAX_AGE_S=20
# DARK_FOLLOW_MIN_SOLVES=3
# DARK_FOLLOW_MAX_VEL_SIGMA_MS=115
# DARK_FOLLOW_INTERVAL_S=2.0
# DARK_FOLLOW_COOLDOWN_S=30
# DARK_FOLLOW_MANOEUVRE_KEEP=0.3
# DARK_FOLLOW_MANOEUVRE_MAX_VEL_SIGMA_MS=600
# DARK_FOLLOW_MANOEUVRE_KEEP_MAX_S=30
# DARK_FOLLOW_GATE_VEL_SIGMA_CAP_MS=115

# Node-side tracking (services/node_tracks.py). NODE_TRACKS_MODE: off | live.
# off (the default) files the tracks a node sends and keeps the server's own
# tracker for every node; live cuts a node over to its own tracks on the first
# frame it sends with them. Set per environment, so one can run node tracks
# while another, fed the same frames through the detection mirror, keeps the
# server's tracker to compare against.
# NODE_TRACKS_MODE=off

# Detection mirror. Production only. Every accepted v1 detection frame is
# forwarded to other environments' /api/radar/detections/bulk, batched once a
# second and posted to every receiver at once, dropped rather than retried
# when a receiver is unreachable, and invisible to the nodes either way. Both
# variables are comma-separated lists in the same order, one key per URL, and
# each key must match that receiver's RADAR_API_KEY; whitespace around entries
# is ignored. A key entry may be left empty (`k1,`) for a receiver that has no
# RADAR_API_KEY set, which is that receiver's choice, not this one's. Lists of
# different lengths, an empty URL entry, or a URL that is not https, leave the
# mirror unarmed altogether rather than arming the receivers that were fine.
# Unset disables the mirror entirely, which is where every other environment
# stands.
# DETECTION_MIRROR_URL=https://test-api.retina.fm,https://staging-api.retina.fm
# DETECTION_MIRROR_KEY=
# Node-location privacy. Receivers sit at people's homes, so every payload a
# public client can reach carries a deterministically displaced receiver
# position instead of the true one (services/public_location.py). The pipeline
# still solves against the truth — this is a serialization-boundary change
# only — and transmitters, being licensed broadcast towers, are never moved.
#
# NODE_FUZZ_MODE=off disables it and serves true receiver coordinates. There is
# no reason to set that on anything a stranger can reach.
#
# Each node is displaced along a bearing uniform in [0, 360) by a distance
# uniform in [NODE_FUZZ_MIN_KM, NODE_FUZZ_MAX_KM] — a donut, not a disc, so no
# node is ever left close to home. NODE_FUZZ_MAX_KM is also what clients are
# told the uncertainty is (location_uncertainty_km), so widening it widens the
# disc the map draws.
#
# CHANGING EITHER BOUND MOVES EVERY NODE, and to a new bearing, not just a new
# distance: the bounds in force are part of the HMAC message, so a change of
# bounds is a full re-fuzz that needs no accompanying salt rotation to be safe.
# That is deliberate — re-drawing only the distance would leave every node on
# its old bearing, and anyone holding a position from both frames (the live map
# and the public Parquet archive suffice) could then solve for the true
# receiver exactly. Two consequences worth planning for before you edit these:
# archived Parquet already published in the old frame stays there and no longer
# agrees with the map, and anyone who kept a copy of the old frame gets a
# second, independent sample of each node. Both are the ordinary price of a
# re-fuzz; neither is a reason to change the bounds without changing the frame.
#
# NODE_FUZZ_SALT keys the HMAC that picks each node's offset. Set it and the
# offsets are reproducible across environments and rebuilds; leave it unset and
# the server generates one on first boot and persists it under
# backend/data/runtime/node_fuzz_salt, which keeps offsets stable across
# restarts but makes them local to that deployment's volume. CHANGING IT MOVES
# EVERY NODE ON THE MAP — treat it as a secret, back it up with the volume, and
# do not rotate it casually.
# NODE_FUZZ_MODE=on
# Receivers at one site share a single offset and are published at one point,
# because two independent offsets around one house are two samples of it and
# an attacker intersects them (services/node_sites.py). Receivers configured at
# the SAME coordinates are always one site. A receiver alone at its coordinates
# but within NODE_FUZZ_SITE_KM of an existing site joins it and is published
# from that site's position — two fixes typed for one roof are rarely equal.
# Pairs up to twice that distance that did not merge are logged as near
# misses; align their configs, or widen the radius, to group them. 0 keeps the
# exact-equality rule only. (NODE_FUZZ_SITE_AUDIT_KM is the older name for the
# same value and is still read.)
# NODE_FUZZ_MIN_KM=0.5
# NODE_FUZZ_MAX_KM=1.0
# NODE_FUZZ_SITE_KM=0.15
# NODE_FUZZ_SALT=

# Uncertainty disc around multinode solves (services/solve_uncertainty.py).
# sigma_solve = sqrt((GAIN*min(formal_sigma, CAP))^2 + FLOOR(lane, n)^2), clamped
# to [50, 5000] m. The dark lane uses the DARK floors INSTEAD of the plain ones.
# Known-lane floors are 95%-calibrated on 944 ground-truthed solves (2026-09-05);
# dark floors are 68%-calibrated on 1030 ground-truthed dark solves (2026-09-06),
# because dark error is heavy-tailed and an honest 95% dark disc is unreadable.
# The map ring is the 68% radius (1.5096*sigma); the panel also quotes 95%
# (2.4477*sigma). See docs/design-notes/2026-09-05-solve-uncertainty-disc.md.
# SOLVE_SIGMA_FORMAL_GAIN=1.0      # gain on the solver's formal pos_sigma_km
# SOLVE_SIGMA_FORMAL_CAP_M=3000    # cap on that formal term (its tail is degenerate)
# SOLVE_SIGMA_FLOOR_N2_M=650       # known-lane unmodeled-error floor, 2-node solves
# SOLVE_SIGMA_FLOOR_N3_M=210       # known-lane unmodeled-error floor, 3-node solves
# SOLVE_SIGMA_FLOOR_N4_M=180       # known-lane unmodeled-error floor, 4+-node solves
# SOLVE_SIGMA_DARK_FLOOR_N2_M=2100 # dark-lane floor, 2-node solves (68%-calibrated)
# SOLVE_SIGMA_DARK_FLOOR_N3_M=850  # dark-lane floor, 3-node solves
# SOLVE_SIGMA_DARK_FLOOR_N4_M=240  # dark-lane floor, 4+-node solves
# SOLVE_SIGMA_DARK_GAIN=1.0        # legacy dark multiplier, unit since the dark floors landed
# SOLVE_SIGMA_VEL_DEFAULT_MS=25    # velocity sigma for disc growth when the KF has no state

# Display-track smoother (services/track_filter.py). The per-key Kalman filter
# is constant-velocity, and a turning aircraft is not: at 250 m/s a 3 deg/s
# turn pulls 13 m/s^2, an order of magnitude past what the straight-flight
# process noise admits, and the chi-squared gate used to read the resulting
# innovation as an identity break and re-anchor the track (which splits one
# aircraft into two mn-dark-* keys and drops its dark_follow target). sigma_a
# is now raised toward the manoeuvre value while a track is being surprised
# and decays back afterwards; a gate breach is retried once with it before any
# re-anchor. Setting TRACK_KF_SIGMA_A_MANOEUVRE at or below TRACK_KF_SIGMA_A
# disables the adaptive path entirely and restores the pre-2026-09 behaviour.
# TRACK_KF_SIGMA_A=1.5              # straight-flight process noise, m^2/s^3
# TRACK_KF_SIGMA_A_MANOEUVRE=800    # process noise while manoeuvring, m^2/s^3
# TRACK_KF_MANOEUVRE_D2=2.0         # normalised innovation that engages it (chi2, 2 dof)
# TRACK_KF_MANOEUVRE_TAU_S=15       # decay time constant back to the base, s

# Per-node tracker process noise (pipeline/passive_radar.py). The same turn
# problem one stage earlier, in retina-tracker's delay/Doppler Kalman filter:
# the packaged q_doppler=0.5 sustains ~2 Hz/s of Doppler acceleration, about a
# 0.7 deg/s turn at 250 m/s on 195 MHz, so a 3 deg/s turn (8-17 Hz/s) throws
# the second turn frame outside the chi-square gate and the track coasts, dies
# and is reborn under a new id. Offline replay of the tracker at q_doppler=20
# cut 3 deg/s breaks from 4.55 to 0.45/min for 20% worse Doppler RMS.
#
# Unset leaves the library's own config.yaml in charge, which is where main
# stands; a set value must parse as a float > 0 or it is ignored with a
# warning. Server-side only — receiver nodes run their own pinned tracker
# image and read their own YAML, which this never touches.
# TRACKER_PROCESS_NOISE_DOPPLER=0.5  # Doppler process noise, Hz^2/s^3
# TRACKER_PROCESS_NOISE_DELAY=0.1    # delay process noise, us^2/s^3

# Solver process pool (services/tasks/solver_pool.py). The LM solves run in
# spawn children so the optimizer is off the GIL; SOLVER_POOL=0 keeps them inline
# (what the test suite does). SOLVER_POOL_CALL_TIMEOUT_S bounds one round trip:
# a solve is well under a second and the queue drops items past 45 s, so a call
# still outstanding at 30 s has lost its work — before the timeout a child that
# was alive but stuck held one of the two worker threads for the process
# lifetime with no counter moving. On expiry the pool is torn down and rebuilt,
# the solve is retried inline, and solver_pool_timeouts / task_error_counts
# ["solver_pool"] record it.
# SOLVER_WORKERS=2
# SOLVER_POOL=1
# SOLVER_POOL_CALL_TIMEOUT_S=30

# Node reputation penalties (retina-analytics NodeReputation, evaluated every
# 60 s by services/tasks/periodic.reputation_evaluator). Multiplies EVERY
# penalty: trust 0.15/0.05, stale heartbeat 0.1, high detection rate 0.05,
# neighbour inconsistency 0.08, ADS-B cross-validation 0.1. Rewards are not
# scaled. 0 means no penalty is recorded at all, so no node can be blocked by
# any of these paths; 1 is the historical behaviour.
#
# The default is 0, and it is TEMPORARY (set 2026-09-18). The only trust input
# today is a single claim residual from the identity-first lane: one
# out-of-threshold residual scores a node 0.0, and 0.15 a pass takes it from
# 1.0 through the 0.2 block threshold in six minutes. That blocked a real
# mirrored node on the test droplet off ONE sample — and a blocked node has
# every frame dropped, cannot earn its way back (apply_reward is a no-op while
# blocked), and stays blocked across restarts because the block is persisted in
# the state snapshot. Put it back to 1 once trust is computed from enough
# evidence to act on.
#
# This only stops NEW penalties. Blocks a snapshot already carries are cleared
# with backend/scripts/unblock_nodes.py — see docs/runbook.md.
# REPUTATION_PENALTY_SCALE=0

# Detection-archive buffering (services/frame_processor.py). Frames are kept in
# the buffer across a failed Parquet write so a transient disk-full does not
# drop data, and the per-node key is released only by a successful write that
# empties it — so a node that departs mid-outage used to pin up to
# 2*ARCHIVE_BATCH_MAX frames for the process lifetime and be retried on every
# hourly flush cycle forever. A buffer is now abandoned once its node has left
# connected_nodes AND its writes have been failing this long. A node that is
# still connected keeps its frames however long the outage lasts.
# ARCHIVE_BUFFER_FAIL_TTL_S=21600

# Admin Infrastructure page. A DigitalOcean personal access token with only the
# read scopes uptime:read, monitoring:read and droplet:read. Unset disables the
# page, which then says so rather than rendering blanks. Deployed: set by hand
# in each droplet's backend/.env, like the alerting secrets.
DIGITALOCEAN_READ_TOKEN=
# The droplet tag the page lists. Defaults to `retina`, the tag the resource
# alert policies target (claude-shared docs/runbooks/uptime-monitoring.md).
# DIGITALOCEAN_DROPLET_TAG=retina

# Extra CIDRs, comma-separated, a polled radar may never reach: our droplets' public addresses.
POLLED_RADAR_DENY_CIDRS=
