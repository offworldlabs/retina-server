# Environment for the node-performance evaluation units (deploy/perf-eval).
# Installed as /etc/retina-perf/env by install.sh; edit the copy, not this file.

# Private derived data: ADSBHub truth, registry copy, processed windows, dashboard.
RETINA_PERF_ROOT=/var/lib/retina-perf
# The live node registry; copied with sqlite's backup API before each use.
RETINA_REGISTRY_SOURCE=/var/lib/docker/volumes/retina-server_backend-data/_data/users.db
# The server's events log, read for node offline events.
RETINA_EVENTS_JSON=/var/lib/docker/volumes/retina-server_backend-data/_data/events.json
# The server's coverage data: detection archive, ADS-B store, learned fields of view.
RETINA_COVERAGE_DATA=/var/lib/docker/volumes/retina-server_backend-coverage-data/_data
# The backend checkout the evaluation runs from, mounted read-only into the image.
RETINA_PERF_BACKEND=/opt/retina-server/backend
# The server image, which has the evaluation's dependencies (pyarrow, numpy, scipy).
RETINA_PERF_IMAGE=retina-server:latest
# Memory cap for one evaluation container, and how many nodes it scores at once
# (processes; each holds one node's window, a few hundred MB for a busy node).
RETINA_PERF_MEMORY=3000m
RETINA_PERF_WORKERS=2
# The ADSBHub service the recorder polls.
ADSB_SERVICE_URL=https://adsb.retina.fm
POLL_INTERVAL_S=10
REQUEST_SPACING_S=0.6
# Where the dashboard is served, loopback only; reach it over an SSH tunnel.
RETINA_PERF_DASHBOARD_PORT=8765
