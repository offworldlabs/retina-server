# ── Single nginx config for every deployed environment ───────────────────────
# Rendered at container boot by deploy/start.sh via deploy/render-nginx-config.py:
# `# RETINA_INCLUDE <path>` markers are inlined from deploy/nginx/, then the
# brace-delimited placeholders below are substituted from an explicit allowlist.
# Production and staging run *the same* routing, security headers and rate
# limits — only the hostnames and the CSP's connect-src differ.
#
# This replaced a hand-maintained nginx.conf + nginx-staging.conf pair that had
# silently diverged: staging had no Content-Security-Policy on any vhost and no
# /api/auth/ rate limit, so both were effectively untested until production.
#
# Every placeholder used here MUST appear in SUBSTITUTIONS in
# render-nginx-config.py and in both compose overlays; the renderer fails the
# boot if one is missing,
# and CI asserts the two environments render to the same config modulo
# hostnames (deploy/check-env-parity.sh).

# A redirect to a relative target (`return 301 /path/`, `rewrite ... permanent`,
# a directory's missing slash) goes out as a relative Location, which the
# browser resolves against the URL it requested. An absolute one is built from
# the listen port, the container's 80 on the laptop stack, and loses the
# published 8080. This file is included inside http {}, so the line covers every
# vhost.
absolute_redirect off;

# RETINA_IF TLS
# Redirect all HTTP → HTTPS
server {
    listen 80;
    server_name ${HOST_MAIN} ${HOST_API} ${HOST_APP} ${HOST_ADMIN} _;
    return 301 https://$host$request_uri;
}

# Every name no vhost below claims. nginx answers an unmatched host from the
# FIRST block on the port, so without this a node calling /api/towers on a
# mistyped name got the tower SPA's HTML with a 200. Keep it first, so the
# positional default and the declared one cannot disagree.
#
# TLS-only: the laptop stack renders plain HTTP and reaches the frontend on bare
# localhost:8080, a name no server_name claims, so it still needs the fall-through.
server {
    listen 443 ssl default_server;
    server_name _;

    # Without this the catch-all is the one block accepting a handshake from
    # something that is not Cloudflare.
    # RETINA_INCLUDE snippets/tls.conf

    # No security-headers snippet here (nothing is served), but the refusal is
    # still ours and a probe must be able to tell.
    # RETINA_INCLUDE snippets/origin-marker.conf

    # The authority is wrong, not the path.
    return 421;
}
# RETINA_ENDIF

# ${HOST_MAIN} — tower finder frontend
server {
    # RETINA_IF TLS
    listen 443 ssl;
    # RETINA_ELSE
    listen 80;
    # RETINA_ENDIF
    server_name ${HOST_MAIN};

    # RETINA_IF TLS
    # RETINA_INCLUDE snippets/tls.conf
    # RETINA_ENDIF
    # RETINA_INCLUDE snippets/security-headers-page.conf

    root /app/frontend/dist;
    index index.html;

    # WebSocket → FastAPI backend
    location /ws/ {
        # RETINA_INCLUDE snippets/ws.conf
    }

    # API requests → FastAPI backend
    location /api/ {
        # RETINA_INCLUDE snippets/api.conf
    }

    location /api/auth/ {
        # RETINA_INCLUDE snippets/auth.conf
    }

    # Longer prefixes than /api/auth/, so nginx matches these first: session
    # reads get the `session` zone instead of the credential-grade `auth` one.
    location /api/auth/me {
        # RETINA_INCLUDE snippets/session.conf
    }

    location /api/auth/logout {
        # RETINA_INCLUDE snippets/session.conf
    }

    # Longer still than /api/auth/me, so it wins over the session zone above:
    # minting and revoking device-claim credentials is not a session read.
    location /api/auth/me/claim-codes {
        # RETINA_INCLUDE snippets/claim-codes.conf
    }

    # RETINA_IF TOWER_FINDER
    # RETINA_INCLUDE snippets/towers-proxy.conf
    # RETINA_ENDIF

    # Frontend SPA at /towers as well as at the root
    location /towers {
        alias /app/frontend/dist;
        try_files $uri $uri/ /index.html;
    }

    # RETINA_INCLUDE snippets/spa.conf
}

# ${HOST_API} — dedicated API subdomain
server {
    # RETINA_IF TLS
    listen 443 ssl;
    # RETINA_ELSE
    listen 80;
    # RETINA_ENDIF
    server_name ${HOST_API};

    # RETINA_IF TLS
    # RETINA_INCLUDE snippets/tls.conf
    # RETINA_ENDIF
    # RETINA_INCLUDE snippets/security-headers-api.conf

    location /ws/ {
        # RETINA_INCLUDE snippets/ws.conf
    }

    location /api/auth/ {
        # RETINA_INCLUDE snippets/auth.conf
    }

    # Longer prefixes than /api/auth/, so nginx matches these first: session
    # reads get the `session` zone instead of the credential-grade `auth` one.
    location /api/auth/me {
        # RETINA_INCLUDE snippets/session.conf
    }

    location /api/auth/logout {
        # RETINA_INCLUDE snippets/session.conf
    }

    # Longer still than /api/auth/me, so it wins over the session zone above:
    # minting and revoking device-claim credentials is not a session read.
    location /api/auth/me/claim-codes {
        # RETINA_INCLUDE snippets/claim-codes.conf
    }

    # The public name for tower ranking; `/api/api/towers` is what a prefix
    # proxy would send. Exact match, or the prefix would also claim /towersfoo.
    # The rewrite must be explicit: proxy_pass with a variable does not
    # substitute the location prefix.
    #
    # The rewrite comes LAST, after the include. `break` stops every remaining
    # ngx_http_rewrite_module directive in this location, and `set` is one of
    # them — so a rewrite placed first leaves $tfs_upstream empty and nginx
    # answers 500 ("no host in upstream :8000") on this vhost alone. proxy_pass
    # runs in the content phase and is unaffected by the order here.
    # RETINA_IF TOWER_FINDER
    location = /towers {
        # RETINA_INCLUDE snippets/tower-finder.conf
        rewrite ^/towers$ /api/towers break;
    }

    # tower-finder-service's schema, for the API reference at /
    # (backend/routes/reference.py). That service sends no CORS header, so the
    # page reads it from this origin. Rewrite last, as above.
    location = /openapi/tower-finder.json {
        # RETINA_INCLUDE snippets/tower-finder.conf
        rewrite ^ /openapi.json break;
    }
    # RETINA_ENDIF

    location / {
        # RETINA_INCLUDE snippets/api.conf
    }
}

# ${HOST_APP} — the consolidated public surface: the live map at / and the
# dashboard's public and owner pages, the data explorer among them, under
# /dash/. One hostname because the session cookie is host-only
# (backend/core/users.py sets no cookie_domain), so a login on the map is only
# a login on the dashboard while the two share an origin.
server {
    # RETINA_IF TLS
    listen 443 ssl;
    # RETINA_ELSE
    listen 80;
    # RETINA_ENDIF
    server_name ${HOST_APP};

    # RETINA_IF TLS
    # RETINA_INCLUDE snippets/tls.conf
    # RETINA_ENDIF
    # RETINA_INCLUDE snippets/security-headers-page.conf

    root /app/frontend/dist;
    index index.html;

    # WebSocket → FastAPI backend
    location /ws/ {
        # RETINA_INCLUDE snippets/ws.conf
    }

    # API requests → FastAPI backend
    location /api/ {
        # RETINA_INCLUDE snippets/api.conf
    }

    # This vhost serves the sign-in pages, so the credential-grade rate limit
    # belongs here as it does on ${HOST_MAIN}.
    location /api/auth/ {
        # RETINA_INCLUDE snippets/auth.conf
    }

    # Longer prefixes than /api/auth/, so nginx matches these first: session
    # reads get the `session` zone instead of the credential-grade `auth` one.
    location /api/auth/me {
        # RETINA_INCLUDE snippets/session.conf
    }

    location /api/auth/logout {
        # RETINA_INCLUDE snippets/session.conf
    }

    # Longer still than /api/auth/me, so it wins over the session zone above:
    # minting and revoking device-claim credentials is not a session read.
    location /api/auth/me/claim-codes {
        # RETINA_INCLUDE snippets/claim-codes.conf
    }

    # RETINA_IF TOWER_FINDER
    # RETINA_INCLUDE snippets/towers-proxy.conf
    # RETINA_ENDIF

    # `/dash` does not contain `/dash/`, so it misses the mount below, falls
    # through to spa.conf's `location /` and answers 200 with the MAP bundle.
    # An exact match outranks every prefix, so this wins without disturbing it.
    location = /dash {
        # $is_args$args: a `return` drops the query string, a rewrite keeps it.
        return 301 /dash/$is_args$args;
    }

    # The dashboard bundle, the same one ${HOST_ADMIN} serves at its root.
    #
    # `^~` is load-bearing, not decoration: spa.conf below ends in regex
    # locations, a regex beats a prefix whatever their lengths, and those
    # regexes resolve against this vhost's root — so without it
    # /dash/assets/index-<hash>.js is served from /app/frontend/dist and 404s.
    # `^~` tells nginx to stop at the prefix and never consult them.
    #
    # Declaring add_header here costs this location the server-level security
    # headers, as spa.conf's locations already cost every other page vhost
    # theirs: no HTML response anywhere carries a CSP today (ClickUp
    # 123zgec37tp). Fixing that has to cover this mount too.
    location ^~ /dash/ {
        alias /app/dashboard/dist-dash/;
        try_files $uri $uri/ /dash/index.html;
        add_header Cache-Control "no-store, no-cache";

        # Vite's hashed output, and nothing else, may be kept for a week —
        # same rule and same reasoning as spa.conf's /assets/ location.
        location ^~ /dash/assets/ {
            alias /app/dashboard/dist-dash/assets/;
            expires 7d;
            add_header Cache-Control "public, immutable";
        }
    }

    # The standalone data explorer's old address, still in circulation as
    # links. Their query parameters are the ones the dashboard's page reads
    # (dataExplorer/urlState.ts), so keeping the query string keeps them
    # working, and every path under it lands on the one page. `/data` needs the
    # exact match for the reason `/dash` does, and `^~` stops spa.conf's regexes
    # answering /data/*.js from the map's root.
    location = /data {
        return 301 /dash/data$is_args$args;
    }

    location ^~ /data/ {
        return 301 /dash/data$is_args$args;
    }

    # RETINA_INCLUDE snippets/spa.conf
}

# ${HOST_ADMIN} — admin dashboard. The same bundle ${HOST_APP} mounts at
# /dash/, built at the root instead, and the hostname is what selects the admin
# route table (dashboard/src/utils/surface.ts). It keeps a name of its own
# because a Cloudflare Access application can only be scoped to one.
server {
    # RETINA_IF TLS
    listen 443 ssl;
    # RETINA_ELSE
    listen 80;
    # RETINA_ENDIF
    server_name ${HOST_ADMIN};

    # RETINA_IF TLS
    # RETINA_INCLUDE snippets/tls.conf
    # RETINA_ENDIF
    # RETINA_INCLUDE snippets/security-headers-page.conf

    root /app/dashboard/dist;
    index index.html;

    location /ws/ {
        # RETINA_INCLUDE snippets/ws.conf
    }

    location /api/ {
        # RETINA_INCLUDE snippets/api.conf
    }

    # This vhost answers /api/ from the monolith, which still carries reachable
    # tower routes, so it forwards them rather than answering a second version:
    # one path, one answer per environment. The admin bundle is the surface an
    # operator reads config from, so it must not be the one showing a stale
    # copy. Note the dashboard's own config screen calls /api/admin/config/*,
    # which is NOT under any prefix here and still reaches the monolith.
    # RETINA_IF TOWER_FINDER
    # RETINA_INCLUDE snippets/towers-proxy.conf
    # RETINA_ENDIF

    # RETINA_INCLUDE snippets/spa.conf
}
